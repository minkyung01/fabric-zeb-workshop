  "timeseriesProperties": [],
  "semanticEnrichment": {
    "synonyms": [
      "\uC81C\uB85C\uC5D0\uB108\uC9C0\uAC74\uCD95\uBB3C\uC778\uC99D",
      "ZEB\uC778\uC99D",
      "\uC81C\uB85C\uC5D0\uB108\uC9C0\uC778\uC99D"
    ],
    "description": "\uD55C\uAD6D\uC5D0\uB108\uC9C0\uACF5\uB2E8 \uC81C\uB85C\uC5D0\uB108\uC9C0\uAC74\uCD95\uBB3C \uC778\uC99D \uD604\uD669(\uACF5\uACF5\uB370\uC774\uD130, 2025-12-31 \uAE30\uC900). \uD55C \uD589\uC774 \uC778\uC99D 1\uAC74. \uB4F1\uAE09 \uC21C\uC11C\uC640 \uD310\uC815 \uC808\uCC28\uB294 ZEBGradeCriteria\uB97C \uB530\uB978\uB2E4. \uC608\uBE44\uC778\uC99D = \uC124\uACC4 \uB2E8\uACC4\uC5D0\uC11C \uC124\uACC4\uB3C4\uC11C\uB85C \uBC1B\uB294 \uC778\uC99D. \uBCF8\uC778\uC99D = \uC900\uACF5(\uC0AC\uC6A9\uC2B9\uC778) \uBB34\uB835 \uCD5C\uC885 \uC124\uACC4\uB3C4\uC11C\uC640 \uD604\uC7A5 \uC2E4\uC0AC\uB85C \uBC1B\uB294 \uC778\uC99D\uC73C\uB85C, \u0027\uC900\uACF5 \uD6C4 \uC778\uC99D\u0027\uC774\uB77C\uACE0\uB3C4 \uD55C\uB2E4. ZEB \uB4F1\uAE09\uC740 \u002B(ZEB\u002B)\uAC00 \uAC00\uC7A5 \uB192\uACE0 1, 2, 3, 4, 5 \uC21C\uC11C\uB85C \uB0AE\uC544\uC9C4\uB2E4. \u0027N\uB4F1\uAE09 \uC774\uC0C1\u0027\uC740 N\uB4F1\uAE09\uACFC \uADF8\uBCF4\uB2E4 \uB192\uC740 \uB4F1\uAE09\uC744 \uB73B\uD55C\uB2E4. \uC608: \u00274\uB4F1\uAE09 \uC774\uC0C1\u0027 = \u002B, 1, 2, 3, 4\uB4F1\uAE09(5\uB4F1\uAE09 \uC81C\uC678). ZEB \uC608\uC0C1 \uB4F1\uAE09 \uD310\uC815 \uC808\uCC28(\uB450 \uAE30\uC900 \uC911 \uD558\uB098\uB9CC \uCDA9\uC871\uD574\uB3C4 \uB428): (1) \uC790\uB9BD\uB960 \uB4F1\uAE09 = selfsuff_pct \u003E= selfsuff_min_pct\uB97C \uB9CC\uC871\uD558\uB294 \uB4F1\uAE09 \uC911 \uAC00\uC7A5 \uB192\uC740 \uB4F1\uAE09. (2) 1\uCC28\uC5D0\uB108\uC9C0 \uB4F1\uAE09 = primary_energy_kwh_m2y \u003C \uAE30\uC900\uAC12\uC744 \uB9CC\uC871\uD558\uB294 \uB4F1\uAE09 \uC911 \uAC00\uC7A5 \uB192\uC740 \uB4F1\uAE09(\uAE30\uC900\uAC12: \uC8FC\uAC70\uC6A9\uC774\uBA74 primary_energy_limit_residential, \uC8FC\uAC70\uC6A9 \uC774\uC678\uBA74 primary_energy_limit_nonresidential). (3) \uCD5C\uC885 \uB4F1\uAE09 = (1)\uACFC (2) \uC911 \uB354 \uB192\uC740 \uB4F1\uAE09. \uB450 \uAE30\uC900\uC744 \uBAA8\uB450 \uCDA9\uC871\uD574\uC57C \uD558\uB294 \uAC83\uC774 \uC544\uB2C8\uBBC0\uB85C, \uC790\uB9BD\uB960\uC774 \uC5B4\uB5A4 \uB4F1\uAE09\uC758 \uD558\uD55C\uBCF4\uB2E4 \uB0AE\uC544\uB3C4 1\uCC28\uC5D0\uB108\uC9C0\uC18C\uC694\uB7C9\uC774 \uADF8 \uB4F1\uAE09 \uAE30\uC900\uAC12\uBCF4\uB2E4 \uB0AE\uC73C\uBA74 \uADF8 \uB4F1\uAE09\uC744 \uBC1B\uB294\uB2E4. (4) BEMS \uB610\uB294 \uC6D0\uACA9\uAC80\uCE68 \uC124\uCE58\uB294 \uD544\uC218 \uC694\uAC74\uC774\uB2E4. \uC8FC\uAC70\uC6A9 = \uACF5\uB3D9\uC8FC\uD0DD(\uC544\uD30C\uD2B8)\uACFC \uB2E8\uB3C5\uC8FC\uD0DD, \uADF8 \uBC16\uC758 \uC6A9\uB3C4\uB294 \uC8FC\uAC70\uC6A9 \uC774\uC678\uB2E4(ref_building_use.use_family). \uACF5\uACF5 ZEB \uC778\uC99D\uC740 residential_type(\uAE30\uAD00 \uC6D0\uBCF8 \uAD6C\uBD84: \uC8FC\uAC70\uC6A9/\uC8FC\uAC70\uC6A9 \uC774\uC678)\uB3C4 \uC788\uB2E4. \uC2DC\uB3C4\uB294 \uC6D0\uCC9C\uB9C8\uB2E4 \uD45C\uAE30\uAC00 \uB2EC\uB77C(\uACBD\uAE30\uB3C4, \uACBD\uAE30, \uC11C\uC6B8\uC2DC \uB4F1) \uD1B5\uC77C\uD55C \uAC12(sido: \uACBD\uAE30, \uC11C\uC6B8, \uC804\uBD81 \uB4F1)\uC744 \uC4F4\uB2E4. \uC6B0\uB9AC \uD68C\uC0AC(Contoso) \uD604\uC7A5\uC740 \uACF5\uACF5 \uC778\uC99D \uB370\uC774\uD130(ZEB\u00B7\uB179\uC0C9\uAC74\uCD95\u00B7BF\u00B7\uB179\uC0C9\uAE30\uC220 \uC778\uC99D \uD604\uD669)\uC5D0 \uC5C6\uB2E4. \uC9C8\uBB38\uC5D0 \uB098\uC628 \u0027\u25CB\u25CB \uD604\uC7A5\u0027, \u0027\u25CB\u25CB\uB2E8\uC9C0\u0027 \uAC19\uC740 \uC774\uB984\uC740 \uC77C\uBD80\uB9CC \uC77C\uCE58\uD574\uB3C4(\uC608: \u0027D\uB2E8\uC9C0\u0027) \uD604\uC7A5 \uC774\uB984(pms_site.site_name, \uC608: \u0027\uD574\uC6B4\uB300 F\uCCAD\uC0AC \uD604\uC7A5\u0027)\uC774\uB098 \uD504\uB85C\uC81D\uD2B8 \uC774\uB984(erp_project.project_name, \uC608: \u0027\uD574\uC6B4\uB300 F\uCCAD\uC0AC\u0027)\uC5D0\uC11C \uCC3E\uB294\uB2E4. \uD604\uC7A5\uC758 \uC2DC\uB3C4\u00B7\uC6A9\uB3C4\uB294 MDM \uB9E4\uD551(mdm_site_xref)\uC73C\uB85C \uC5F0\uACB0\uD55C \uD504\uB85C\uC81D\uD2B8\uC758 sido\u00B7use_group\uC774\uBA70, \uACF5\uACF5 \uC778\uC99D \uC0AC\uB840\uC640 \uBE44\uAD50\uD560 \uB54C\uB294 \uC774 \uC2DC\uB3C4\u00B7\uC6A9\uB3C4\uAC00 \uAC19\uC740 \uACF5\uACF5 \uC778\uC99D\uC744 \uACE0\uB978\uB2E4.",
    "customAttributes": {}
  },
